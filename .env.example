# Copie este arquivo para .env e preencha com suas credenciais reais.
# Sem isso, o app só consegue processar o card de demonstração 0001.

JIRA_EMAIL=seu-email@suaempresa.com
JIRA_TOKEN=seu-token-de-api-aqui
JIRA_DOMAIN=https://suaempresa.atlassian.net

# Prefixo do projeto/board no Jira (ex.: PROJ vira issues PROJ-123)
JIRA_PROJECT_KEY=PROJ

# Nome usado no assunto/corpo do e-mail gerado
NOME_EMPRESA=Sua Empresa
